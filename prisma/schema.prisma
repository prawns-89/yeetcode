generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TypingSession {
  id           String   @id @default(cuid())
  snippetId    String
  snippetTitle String
  mode         String
  netWpm       Int
  rawWpm       Int
  accuracy     Int
  secondsTaken Int
  errors       Int      @default(0)
  completed    Boolean  @default(true)
  attemptedAt  DateTime @default(now())

  @@index([attemptedAt(sort: Desc)])
}

model PersonalBest {
  snippetId    String   @id
  snippetTitle String   @default("")
  bestNetWpm   Int
  bestAccuracy Int
  achievedAt   DateTime
  sessionId    String?
}

model CurriculumProgress {
  snippetId        String   @id
  firstCompletedAt DateTime
  attemptCount     Int      @default(1)
  lastNetWpm       Int
  lastAccuracy     Int
}

model SnippetNote {
  id        String   @id @default(cuid())
  snippetId String
  lineIndex Int
  note      String
  updatedAt DateTime @updatedAt

  @@unique([snippetId, lineIndex])
}

model DailyQuest {
  id          String    @id @default(cuid())
  date        String    // YYYY-MM-DD
  category    String    // NeetCode island category
  problemSlug String
  position    Int       // 1-5, order within today's quest
  completed   Boolean   @default(false)
  completedAt DateTime?

  @@unique([date, category, problemSlug])
  @@index([date, category])
}

model IslandProgress {
  category         String   @id  // NeetCode island category
  totalClears      Int      @default(0)  // full 5/5 days
  totalCompleted   Int      @default(0)  // individual problems done ever
  currentStreak    Int      @default(0)
  lastClearedDate  String?  // YYYY-MM-DD of last full clear
}
